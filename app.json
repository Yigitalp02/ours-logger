{
  "expo": {
    "name": "Ours",
    "slug": "ours-dates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ours",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1115"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ours.datelogger",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ours uses your photos so you can add them to date logs and your profile.",
        "NSCameraUsageDescription": "Ours uses the camera so you can add photos to date logs."
      }
    },
    "android": {
      "package": "com.ours.datelogger",
      "adaptiveIcon": {
        "backgroundColor": "#0C1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ours uses your photos so you can add them to date logs and your profile.",
          "cameraPermission": "Ours uses the camera so you can add photos to date logs."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
